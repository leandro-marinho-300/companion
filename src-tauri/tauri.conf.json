{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Companion",
  "version": "0.2.2",
  "identifier": "br.com.companion.tdahfocus",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Companion — TDAH Focus",
        "url": "index.html",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "resizable": true
      },
      {
        "label": "companion",
        "title": "Companion Compacto",
        "url": "companion.html",
        "width": 430,
        "height": 285,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true,
        "transparent": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Companion de foco para reduzir paralisia, interrupções e perda de contexto.",
    "longDescription": "Um Desktop Companion Windows-first que ajuda a iniciar uma intenção, proteger o foco e recuperar o contexto quando houver desvio.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
